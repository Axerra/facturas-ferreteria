{
  "name": "facturas-ferreteria",
  "version": "1.1.0",
  "description": "Sistema de Facturación - Gallinaza y Materiales Tejada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.gallinaza.facturacion",
    "productName": "Gallinaza Facturación",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "css/**/*",
      "js/**/*",
      "data/**/*",
      "main.js",
      "preload.js",
      "!node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "icon": null
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Axerra",
        "repo": "facturas-ferreteria",
        "releaseType": "draft"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": null,
      "uninstallerIcon": null,
      "installerHeaderIcon": null,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gallinaza Facturación"
    }
  },
  "author": "Gallinaza y Materiales Tejada",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  }
}
